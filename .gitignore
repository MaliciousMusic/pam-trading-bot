# Python. .venv314t/ is the Phase 0.5 free-threaded runtime; kept per-machine
# so the commit stays portable across dev laptops and the future headless box.
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
.venv*/
venv/
.Python

# Runtime data. Local tick ledgers, API caches, and replay outputs are
# per-machine and huge; fixtures + baseline summaries are small, committed
# artifacts the tensor-engine refactor needs for cross-phase parity diffs.
data/*
!data/fixtures/
!data/baseline/
data/baseline/sprint_runs/
logs/

# Archived epochs of runtime data. The folder + README get committed for
# provenance, but the heavy jsonl/json payloads under it stay local.
archive/*/ledger/
archive/*/audit/

# Raw cProfile dumps — per-machine, regenerable via profile_sprint.py.
data/perf/

# WS3 H2 Step 4 sprint-produced resolved-anchor tape. Each day's file is
# ~75 MB; regenerable via scripts/ws3_h2_step4_live_attribution.py against
# the committed BTCUSDT_<day> fixtures. The per-day projector_gain.json
# summary files are tiny and DO get committed for provenance.
research/phase11_diagnostic/_ws3_h2_step4_forecasts/*.jsonl


# IDE
.idea/
.vscode/
*.swp

# Claude Code local session state
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/worktrees/

# OS
.DS_Store
Thumbs.db

# Secrets
.env
.env.*
*.pem
*.key
